# VaultX public form email delivery
# Use placeholder values only in this file. Real values belong in local/Vercel environment settings.
RESEND_API_KEY=
# Comma-separated list of one or more recipient email addresses.
VAULTX_FORM_TO_EMAIL=
VAULTX_FORM_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=

# Public tracking/chat IDs. GTM and Tidio default to the old public source IDs if omitted.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_TIDIO_PUBLIC_KEY=

# Optional Umami migration. The old source used Vite placeholders, so configure both values only if still required.
NEXT_PUBLIC_UMAMI_SCRIPT_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
